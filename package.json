{
  "name": "spell-writer",
  "version": "0.1.0",
  "private": true,
  "description": "Write spells as binary glyphs: Spellbook, Quill and Settings.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.example.spellwriter",
    "productName": "Spell Writer",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  }
}
